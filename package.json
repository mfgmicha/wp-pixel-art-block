{
	"name": "@mfgmicha/pixel-art-creator",
	"version": "0.3.0",
	"description": "An interactive pixel art grid. Visitors paint with your theme's color palette on a configurable grid.",
	"author": "Micha Krapp",
	"license": "GPL-2.0-or-later",
	"main": "build/index.js",
	"scripts": {
		"build": "wp-scripts build --experimental-modules",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"start": "wp-scripts start --experimental-modules",
		"test:playwright": "wp-scripts test-playwright",
		"test:playwright:help": "wp-scripts test-playwright --help",
		"test:playwright:debug": "wp-scripts test-playwright --debug",
		"makepot": "make-pot src languages --slug=pixel-art-creator --domain=block --headers=email:michakrapp@gmail.com --headers=\"name:Pixel Art Creator\" --headers=\"version:0.3.0\" --headers=\"author:Micha Krapp\"",
		"makejson": "make-json build languages --slug=pixel-art-creator",
		"env:start": "wp-playground-cli start --port 8889 --blueprint ./.wordpress/blueprint.json",
		"env:stop": "echo 'Server stopped (Ctrl+C)'"
	},
	"devDependencies": {
		"@wordpress/scripts": "^30.15.0",
		"@wp-blocks/make-pot": "^1.6.6",
		"@wp-playground/cli": "^3.1.2"
	}
}
